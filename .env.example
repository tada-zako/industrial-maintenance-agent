# Copy to .env only if you want to override the local development defaults.
# Never commit real API keys or passwords.
HERMES_API_KEY=replace-with-a-local-hermes-api-key
NEO4J_PASSWORD=replace-with-a-local-neo4j-password

# maintenance-service
DATABASE_URL=sqlite+aiosqlite:///./services/maintenance_service/data/maintenance.db
# Host-side development uses 127.0.0.1; the Compose service name is neo4j.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
MATERIAL_UPLOAD_DIR=./services/maintenance_service/data/uploads
HERMES_MCP_URL=
# Set this only when the MCP service requires authentication.
HERMES_MCP_AUTH_TOKEN=
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_PATH=/mcp
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
